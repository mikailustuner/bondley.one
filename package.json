{
  "name": "fincalc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@fincalc/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "db:init": "docker exec -i fincalc-postgres psql -U fincalc -d fincalc < database/init.sql"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "npm@10.2.0"
}
