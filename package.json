{
  "name": "fincalc",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@fincalc/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "db:migrate": "docker compose -f docker-compose.prod.yml run --rm migrate"
  },
  "devDependencies": {
    "turbo": "^2.10.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "packageManager": "npm@10.2.0"
}
