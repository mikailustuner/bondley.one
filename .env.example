# Copy to .env. Never commit real secrets.
DOMAIN=bondley.example
FRONTEND_URL=https://bondley.example
CORS_ORIGINS=https://bondley.example,https://dashboard.bondley.example,https://admin.bondley.example

POSTGRES_USER=bondley
POSTGRES_PASSWORD=replace-with-random-32-character-value
POSTGRES_DB=bondley
REDIS_PASSWORD=replace-with-random-32-character-value

JWT_SECRET_KEY=replace-with-random-value-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-value-at-least-32-characters
# URL-safe base64 encoded 32-byte Fernet key. Generate with scripts/generate_secrets.sh.
MFA_ENCRYPTION_KEY=replace-with-fernet-key

ADMIN_EMAIL=admin@bondley.example
ADMIN_INIT_PASSWORD=replace-with-a-strong-initial-password

SMTP_HOST=smtp.example
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

BIST_EXPECTED_READY_TIME=16:15
# Official exchange closure dates not covered by fixed national holidays, comma-separated.
BIST_HOLIDAYS=
BIST_BOOTSTRAP_ENABLED=true
BIST_BOOTSTRAP_IF_EMPTY=true
BIST_BOOTSTRAP_REQUIRED_FOR_READINESS=true

VALUATION_V2_READ_ENABLED=true
VALUATION_V2_WRITE_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_HOUR=3

SENTRY_DSN=
