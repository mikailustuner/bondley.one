# Copy to .env. Never commit real secrets.
DOMAIN=bondley.example
FRONTEND_URL=https://bondley.example
CORS_ORIGINS=https://bondley.example,https://dashboard.bondley.example,https://admin.bondley.example

POSTGRES_USER=bondley
POSTGRES_PASSWORD=replace-with-random-32-character-value
POSTGRES_DB=bondley
REDIS_PASSWORD=replace-with-random-32-character-value

JWT_SECRET_KEY=replace-with-random-value-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-value-at-least-32-characters
# URL-safe base64 encoded 32-byte Fernet key. Generate with scripts/generate_secrets.sh.
MFA_ENCRYPTION_KEY=replace-with-fernet-key

ADMIN_EMAIL=admin@bondley.example
ADMIN_INIT_PASSWORD=replace-with-a-strong-initial-password

SMTP_HOST=smtp.example
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

BIST_EXPECTED_READY_TIME=16:05
# Official exchange closure dates not covered by fixed national holidays, comma-separated.
BIST_HOLIDAYS=
BIST_BOOTSTRAP_ENABLED=true
BIST_BOOTSTRAP_IF_EMPTY=true
BIST_BOOTSTRAP_REQUIRED_FOR_READINESS=true

# KAP is optional asynchronous enrichment; it never gates bootstrap/readiness.
KAP_INGESTION_ENABLED=false
KAP_PUBLIC_LIST_URL=https://www.kap.org.tr/tr/api/disclosure/members/byCriteria
KAP_PUBLIC_DETAIL_URL_TEMPLATE=https://www.kap.org.tr/tr/Bildirim/{disclosure_id}
# Comma-separated HTTP(S) proxies. Failover is transport-only; a 429 pauses
# the complete pool and never causes proxy rotation.
KAP_PROXY_URLS=
KAP_PROXY_AUTO_REFRESH_ENABLED=false
KAP_PROXY_SOURCE_URL=https://api.proxyscrape.com/v4/free-proxy-list/get?request=displayproxies&protocol=http&timeout=5000&country=all&ssl=yes&anonymity=elite&proxy_format=protocolipport&format=text&limit=100
KAP_PROXY_REFRESH_HOURS=24
KAP_PROXY_MAX_POOL_SIZE=10
KAP_PROXY_REQUIRE_PROXY=false
KAP_REQUEST_INTERVAL_SECONDS=2.0
KAP_REQUEST_JITTER_MIN_MS=250
KAP_REQUEST_JITTER_MAX_MS=750
KAP_HTTP_TIMEOUT_SECONDS=30
KAP_MAX_DETAILS_PER_RUN=50
KAP_ACTIVE_POLL_MINUTES=15
KAP_NIGHT_POLL_MINUTES=60

VALUATION_V2_READ_ENABLED=true
VALUATION_V2_WRITE_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_HOUR=3

SENTRY_DSN=
