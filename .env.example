# PostgreSQL
POSTGRES_USER=fincalc
POSTGRES_PASSWORD=fincalc_secret
POSTGRES_DB=fincalc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fincalc:fincalc_secret@localhost:5432/fincalc

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Admin seed (only when creating initial admin; existing admin is never overwritten)
ADMIN_EMAIL=admin@fincalc.com
# Set in production to create first admin; leave empty in dev to use dev default
ADMIN_INIT_PASSWORD=admin123

# production = reject weak JWT/POSTGRES defaults at startup
ENVIRONMENT=development

# BIST Data
BIST_TLREF_DAILY_URL=https://borsaistanbul.com/datum/bisttlrefendeksi.csv
BIST_TLREF_HISTORICAL_URL=https://borsaistanbul.com/datum/BISTTLREFENDEKSI_D.zip
BIST_BOND_LIST_URL=https://borsaistanbul.com/datum/tbliste.zip

# yeniler
# MFA/2FA: TOTP secret şifreleme için 32-byte Fernet key (base64). JWT secret'tan türetilmemeli.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ile üretin
MFA_ENCRYPTION_KEY=

# Rate limiting (login/signup brute-force koruması)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_HOUR=3

# JWT refresh token (opsiyonel, varsayılanlar kullanılabilir)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
