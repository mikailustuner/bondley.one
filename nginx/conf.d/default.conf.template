# --- Bondley Nginx Gateway (Internal) ---
# This Nginx instance runs inside Docker and handles internal routing.
# SSL is terminated at the host Apache2 level.

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN} api.${DOMAIN} dashboard.${DOMAIN} admin.${DOMAIN};

    # Health check for Nginx itself
    location /nginx-health {
        return 200 "OK";
        add_header Content-Type text/plain;
    }

    # API v1 Proxy
    location /api/v1/ {
        proxy_pass http://api:8000/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Next.js Web Proxy (Handles Landing, Dashboard, Admin paths)
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        
        # Next.js hydration fix
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
